\keys_define:nn { tfl }
  {
    tipografia .choice:,
    tipografia / sans .code:n = { \tl_set:Nn \l__tfl_tipografia_tl { sans } },
    tipografia / serif .code:n = { \tl_set:Nn \l__tfl_tipografia_tl { serif } },
    tipografia .initial:n = sans,
    interlineado .choice:,
    interlineado / uno .code:n = { \tl_set:Nn \l__tfl_interlineado_tl { uno } },
    interlineado / uno-medio .code:n = { \tl_set:Nn \l__tfl_interlineado_tl { uno-medio } },
    interlineado / doble .code:n = { \tl_set:Nn \l__tfl_interlineado_tl { doble } },
    interlineado .initial:n = uno-medio,
    accesibilidad .choice:,
    accesibilidad / standard .code:n = { \tl_set:Nn \l__tfl_access_tl { standard } },
    accesibilidad / experimental .code:n = { \tl_set:Nn \l__tfl_access_tl { experimental } },
    accesibilidad .initial:n = standard,
    encuadernacion .dim_set:N = \l__tfl_binding_dim,
    encuadernacion .initial:n = 5mm
  }
\ProcessKeyOptions [ tfl ]

\keys_define:nn { tfl/figura }
  {
    ancho .tl_set:N = \l__tfl_figure_width_tl,
    ancho .initial:n = 0.9\linewidth,
    etiqueta .tl_set:N = \l__tfl_figure_label_tl,
    etiqueta .initial:n = ,
    alt .tl_set:N = \l__tfl_figure_alt_tl,
    alt .initial:n = ,
    decorativa .bool_set:N = \l__tfl_figure_decorative_bool,
    decorativa .initial:n = false
  }
