% ---------------------------------------------------------------------------
% Bibliografia segun las normas de la Revista de la Asociacion Geologica
% Argentina (RAGA): autor y anio sin coma en las citas; autores separados por
% "y"; anio sin parentesis y revistas sin abreviar en la lista final.
% ---------------------------------------------------------------------------
\DeclareNameAlias{sortname}{family-given}
\DeclareNameAlias{default}{family-given}
\renewrobustcmd*{\bibinitdelim}{}
\DeclareDelimFormat{nameyeardelim}{\addspace}
\DeclareDelimFormat{multinamedelim}{\addcomma\space}
\DeclareDelimFormat{finalnamedelim}{\addspace y\space}
\DeclareDelimFormat{andothersdelim}{\addspace}

\DeclareFieldFormat{title}{#1}
\DeclareFieldFormat[article,incollection,inproceedings,report,thesis,book,online]{title}{#1}
\DeclareFieldFormat[article]{journaltitle}{#1}
\DeclareFieldFormat{volume}{#1}
\DeclareFieldFormat[article,book]{number}{#1}
\DeclareFieldFormat{pages}{#1}
\DeclareFieldFormat{pagetotal}{#1}
\DeclareFieldFormat{url}{\url{#1}}

\newbibmacro*{tfl:raga:author}{%
  \ifnameundef{author}
    {\usebibmacro{editor+others}}
    {\printnames{author}}}

\newbibmacro*{tfl:raga:online}{%
  \iffieldundef{doi}{}{\newunit\printfield{doi}}%
  \iffieldundef{url}{}{\newunit\printfield{url}}}

\newbibmacro*{tfl:raga:pagetotal-location}{%
  \iffieldundef{pagetotal}
    {\iflistundef{location}{}{\printlist{location}}}
    {\printfield{pagetotal}\addspace
     \iflistundef{location}
       {\printtext{p.}}
       {\printtext{p.,}\space\printlist{location}}}}

\newbibmacro*{tfl:raga:editortype}{%
  \ifnumgreater{\value{editor}}{1}
    {\printtext{(eds.)}}
    {\printtext{(ed.)}}}

\DeclareBibliographyDriver{article}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{tfl:raga:author}%
  \setunit{\addperiod\space}%
  \printfield{year}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printfield{journaltitle}%
  \setunit{\addspace}%
  \printfield{volume}%
  \iffieldundef{number}{}{\printtext{\mkbibparens{\printfield{number}}}}%
  \setunit{\addcolon\space}%
  \printfield{pages}%
  \usebibmacro{tfl:raga:online}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{book}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{tfl:raga:author}%
  \setunit{\addperiod\space}%
  \printfield{year}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printlist{publisher}%
  \iffieldundef{series}{}{\setunit{\addcomma\space}\printfield{series}}%
  \iffieldundef{number}{}{\setunit{\addspace}\printfield{number}}%
  \setunit{\addcomma\space}%
  \usebibmacro{tfl:raga:pagetotal-location}%
  \usebibmacro{tfl:raga:online}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{incollection}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{tfl:raga:author}%
  \setunit{\addperiod\space}%
  \printfield{year}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printtext{En\addcolon\space}%
  \printnames{editor}%
  \addspace\usebibmacro{tfl:raga:editortype}\printtext{,\space}%
  \printfield{booktitle}%
  \setunit{\addperiod\space}%
  \printlist{publisher}%
  \setunit{\addcolon\space}%
  \printfield{pages}%
  \iflistundef{location}{}{\setunit{\addcomma\space}\printlist{location}}%
  \usebibmacro{tfl:raga:online}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{inproceedings}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{tfl:raga:author}%
  \setunit{\addperiod\space}%
  \printfield{year}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printfield{booktitle}%
  \iffieldundef{series}{}{\setunit{\addcomma\space}\printfield{series}}%
  \iffieldundef{volume}{}{\setunit{\addspace}\printfield{volume}}%
  \iffieldundef{pages}{}{\setunit{\addcolon\space}\printfield{pages}}%
  \iflistundef{location}{}{\setunit{\addcomma\space}\printlist{location}}%
  \usebibmacro{tfl:raga:online}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{report}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{tfl:raga:author}%
  \setunit{\addperiod\space}%
  \printfield{year}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printlist{institution}%
  \iffieldundef{type}{}{\setunit{\addcomma\space}\printfield{type}}%
  \iffieldundef{number}{}{\setunit{\addspace}\printfield{number}}%
  \iffieldundef{pages}{}{\setunit{\addcolon\space}\printfield{pages}}%
  \iflistundef{location}{}{\setunit{\addcomma\space}\printlist{location}}%
  \usebibmacro{tfl:raga:online}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{online}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{tfl:raga:author}%
  \setunit{\addspace}%
  \printfield{year}%
  \setunit{\addperiod\space}%
  \printfield{url}%
  \renewcommand*{\finentrypunct}{}%
  \usebibmacro{finentry}}

\DeclareBibliographyDriver{thesis}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \usebibmacro{tfl:raga:author}%
  \setunit{\addperiod\space}%
  \printfield{year}%
  \setunit{\addperiod\space}%
  \printfield{title}%
  \setunit{\addperiod\space}%
  \printfield{type}%
  \setunit{\addcomma\space}%
  \printlist{institution}%
  \iffieldundef{note}{}{\addspace\printtext{(\printfield{note})}}%
  \setunit{\addcomma\space}%
  \usebibmacro{tfl:raga:pagetotal-location}%
  \usebibmacro{tfl:raga:online}%
  \usebibmacro{finentry}}

