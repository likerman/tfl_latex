\cs_new_protected:Nn \tfl_portada: {
  \thispagestyle{empty}
  \pagecolor{TFLCoverPaper}
  \begin{titlepage}
  \raggedright
  \setlength{\parindent}{0pt}
  \vspace*{0.45cm}
  \noindent
  \colorbox{TFLCoverBand}{%
    \parbox[t][0.38\paperheight][t]{\dimexpr\textwidth-2\fboxsep\relax}{%
      \vspace*{0.55cm}
      \noindent
      \begin{minipage}[t]{0.64\linewidth}
        {\small\bfseries Trabajo\enspace final\enspace de\enspace licenciatura\par}
        \vspace{0.45em}
        {\small \TFLInstitucion \par}
        {\small \TFLFacultad \par}
        {\small \TFLDepartamento \par}
      \end{minipage}
      \hfill
      \begin{minipage}[t]{0.28\linewidth}
        \raggedleft
        \tl_if_blank:VF \l__tfl_portada_logo_izq_tl {
          \includegraphics[height=14mm,keepaspectratio]{\l__tfl_portada_logo_izq_tl}
        }
        \hspace{0.35em}
        \tl_if_blank:VF \l__tfl_portada_logo_der_tl {
          \includegraphics[height=14mm,keepaspectratio]{\l__tfl_portada_logo_der_tl}
        }
      \end{minipage}\par

      \vfill
      \noindent
      \colorbox{black}{%
        \parbox[c][10mm][c]{0.22\textwidth}{\centering\color{white}\scriptsize\bfseries Trabajo final\strut}%
      }\par
      \vspace*{0.55cm}
    }%
  }\par

  \vspace{1.05cm}
  \begin{minipage}{0.86\textwidth}
    \raggedright
    {\fontsize{27}{32}\selectfont\bfseries \TFLTitulo \par}
    \tl_if_blank:eF { \TFLSubtitulo } {
      \vspace{0.3cm}
      {\normalsize \TFLSubtitulo \par}
    }
  \end{minipage}\par
  \vspace{1.05cm}
  \noindent
  \begin{minipage}[t]{0.60\textwidth}
    {\small\color{TFLCoverMuted} Autor\par}
    \vspace{0.25em}
    {\large \TFLAutor \par}
    \vspace{0.85cm}
    {\small\color{TFLCoverMuted} Direccion\par}
    \vspace{0.25em}
    {\normalsize \TFLDirectores \par}
    \tl_if_blank:eF { \TFLCodirectores } {
      \vspace{0.7cm}
      {\small\color{TFLCoverMuted} Codireccion\par}
      \vspace{0.25em}
      {\normalsize \TFLCodirectores \par}
    }
  \end{minipage}
  \hfill
  \begin{minipage}[t]{0.28\textwidth}
    \raggedleft
    {\small\color{TFLCoverMuted} Lugar\enspace y\enspace fecha\par}
    \vspace{0.25em}
    {\normalsize \TFLLugar \par}
    {\normalsize \TFLMes\space \TFLAnio \par}
  \end{minipage}\par
  \vfill
  \nopagecolor
  \end{titlepage}
}

\NewDocumentCommand{\TFLPortada}{O{}}{%
  \begingroup
  \keys_set:nn { tfl/portada } { #1 }
  \tfl_portada:
  \endgroup
}

\NewDocumentCommand{\TFLFigura}{O{} m m}{%
  \begingroup
  \keys_set:nn { tfl/figura } { #1 }
  \begin{figure}[htbp]
    \centering
    \str_if_eq:VnTF \l__tfl_access_tl { experimental }
      {
        \tl_if_blank:VTF \l__tfl_figure_alt_tl
          { \includegraphics[width=\l__tfl_figure_width_tl]{#2} }
          { \includegraphics[width=\l__tfl_figure_width_tl,alt={\l__tfl_figure_alt_tl}]{#2} }
      }
      { \includegraphics[width=\l__tfl_figure_width_tl]{#2} }
    \caption{#3}
    \tl_if_blank:VF \l__tfl_figure_label_tl { \label{\l__tfl_figure_label_tl} }
  \end{figure}
  \endgroup
}
\ExplSyntaxOff

\newcommand{\TFLFiguraDecorativa}[2][]{%
  \begin{figure}[htbp]
    \centering
    \includegraphics[width=0.9\linewidth]{#2}
    \caption{#1}
  \end{figure}
}

