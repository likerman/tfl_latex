\ExplSyntaxOn
\tl_new:N \l__tfl_tipografia_tl
\tl_new:N \l__tfl_interlineado_tl
\tl_new:N \l__tfl_access_tl
\dim_new:N \l__tfl_binding_dim
\bool_new:N \l__tfl_figure_decorative_bool
\tl_new:N \l__tfl_figure_width_tl
