\ExplSyntaxOn
\keys_define:nn { tfl/portada }
  {
    logo-izq .tl_set:N = \l__tfl_portada_logo_izq_tl,
    logo-izq .initial:n = ,
    logo-der .tl_set:N = \l__tfl_portada_logo_der_tl,
    logo-der .initial:n = ,
    imagen .tl_set:N = \l__tfl_portada_imagen_tl,
    imagen .initial:n = 
  }

\dim_new:N \l__tfl_portada_band_dim
\dim_new:N \l__tfl_portada_inset_dim

\cs_new_protected:Nn \tfl_portada: {
  \thispagestyle{empty}
  \dim_set:Nn \l__tfl_portada_band_dim { 0.32\paperheight }
  \dim_set:Nn \l__tfl_portada_inset_dim { 0.075\paperwidth }

  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{\color{TFLCoverPaper}\rule{\paperwidth}{\paperheight}}%
    \tl_if_blank:VTF \l__tfl_portada_imagen_tl {
      \AtPageUpperLeft{\color{TFLCoverBand}%
        \rule[-\l__tfl_portada_band_dim]{\paperwidth}{\l__tfl_portada_band_dim}}%
    }{
      \AtPageUpperLeft{\raisebox{-\l__tfl_portada_band_dim}[0pt][0pt]{%
        \includegraphics[width=\paperwidth,height=\l__tfl_portada_band_dim]{\l__tfl_portada_imagen_tl}}}%
    }%
  }%

  \AddToShipoutPictureFG*{%
    \tl_if_blank:VF \l__tfl_portada_logo_der_tl {
      \AtPageUpperLeft{\hspace*{\l__tfl_portada_inset_dim}%
        \raisebox{-46mm}[0pt][0pt]{%
          \includegraphics[height=40mm,keepaspectratio]{\l__tfl_portada_logo_der_tl}}}%
    }%
    \AtPageUpperLeft{\hspace*{\l__tfl_portada_inset_dim}%
      \raisebox{-\dimexpr\l__tfl_portada_band_dim-12mm\relax}[0pt][0pt]{%
        \setlength{\fboxsep}{2.5mm}%
        \colorbox{black}{\color{white}\footnotesize\bfseries\selectfont
          \TFLTipoTrabajo}}}%
    \AtPageUpperLeft{\hspace*{\l__tfl_portada_inset_dim}%
      \raisebox{-\dimexpr\l__tfl_portada_band_dim+14mm\relax}[0pt][0pt]{%
        \parbox[t]{0.82\paperwidth}{%
          \raggedright
          {\fontsize{33}{40}\selectfont \TFLTitulo \par}
          \tl_if_blank:eF { \TFLSubtitulo } {
            \vspace{4mm}
            {\normalsize \TFLSubtitulo \par}
          }
          \vspace{50mm}
          {\Large\bfseries \TFLAutor \par}
          \vspace{4mm}
          {\large \textbf{Director/a:}~\TFLDirectores \par}
          \tl_if_blank:eF { \TFLCodirectores } {
            {\large \textbf{Co-director/a:}~\TFLCodirectores \par}
          }
          \vspace{16mm}
          \tl_if_blank:eF { \TFLCarrera } {
            {\normalsize \TFLCarrera \par}
          }
          {\normalsize \TFLDepartamento \par}
          {\normalsize \TFLFacultad \par}
          {\normalsize \TFLInstitucion \par}
        }}}%
    \AtPageLowerLeft{\hspace*{\l__tfl_portada_inset_dim}%
      \raisebox{16mm}[0pt][0pt]{%
        \parbox[b]{0.5\paperwidth}{%
          \small\color{TFLCoverMuted}\TFLLugar \\[0.2em] \TFLFecha}}}%
    \tl_if_blank:VF \l__tfl_portada_logo_izq_tl {
      \AtPageLowerLeft{\hspace*{\dimexpr\paperwidth-\l__tfl_portada_inset_dim\relax}%
        \makebox[0pt][r]{\raisebox{16mm}[0pt][0pt]{%
          \includegraphics[height=25mm,keepaspectratio]{\l__tfl_portada_logo_izq_tl}}}}%
    }%
  }%

  \begin{titlepage}
    \thispagestyle{empty}
    \mbox{}
  \end{titlepage}
}

\NewDocumentCommand{\TFLPortada}{O{}}{%
  \begingroup
  \keys_set:nn { tfl/portada } { #1 }
  \tfl_portada:
  \endgroup
}

\NewDocumentCommand{\TFLFigura}{O{} m m}{%
  \begingroup
  \keys_set:nn { tfl/figura } { #1 }
  \begin{figure}[htbp]
    \centering
    \str_if_eq:VnTF \l__tfl_access_tl { experimental }
      {
        \tl_if_blank:VTF \l__tfl_figure_alt_tl
          { \includegraphics[width=\l__tfl_figure_width_tl]{#2} }
          { \includegraphics[width=\l__tfl_figure_width_tl,alt={\l__tfl_figure_alt_tl}]{#2} }
      }
      { \includegraphics[width=\l__tfl_figure_width_tl]{#2} }
    \caption{#3}
    \tl_if_blank:VF \l__tfl_figure_label_tl { \label{\l__tfl_figure_label_tl} }
  \end{figure}
  \endgroup
}
\ExplSyntaxOff

